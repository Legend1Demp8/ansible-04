---
clickhouse:
  hosts:
%{ for name, vm in workers ~}
%{ if length(regexall("clickhouse", name)) > 0 ~}
    ${vm.name}:
      ansible_host: ${vm.network_interface[0].nat_ip_address}
      ansible_user: ansible
      ansible_connection: ssh
%{ endif ~}
%{ endfor ~}

vector:
  hosts:
%{ for name, vm in workers ~}
%{ if length(regexall("vector", name)) > 0 ~}
    ${vm.name}:
      ansible_host: ${vm.network_interface[0].nat_ip_address}
      ansible_user: vector
      ansible_connection: ssh
%{ endif ~}
%{ endfor ~}

lighthouse:
  hosts:
%{ for name, vm in workers ~}
%{ if length(regexall("lighthouse", name)) > 0 ~}
    ${vm.name}:
      ansible_host: ${vm.network_interface[0].nat_ip_address}
      ansible_user: lighthouse
      ansible_connection: ssh
%{ endif ~}
%{ endfor ~}
